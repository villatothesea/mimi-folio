+// @vitest-environment happy-dom
+
+import { describe, expect, it } from 'vitest';
+import { tokenizer } from '../lexer';
+
+// `**text [a](b)** (c)` lost its strong: the link rule's greedy `(.*)`
+// destination over-reached into a later `)` on the line, so the link "match"
+// extended past the strong's range and `validateEmphasize → lowerPriority`
+// vetoed the emphasis. The lexer corrects link extent with correctUrl's paren
+// balancing — the veto path must apply the same correction.
+
+function strong(src: string) {
+    return tokenizer(src).find(t => t.type === 'strong');
+}
+
+describe('emphasis containing a link — greedy destination correction', () => {
+    it('keeps strong when a parenthesized clause follows the span', () => {
+        const token = strong('**The diagrams are in [x](../pith-flows.html)** (self-contained; open in any browser).');
+        expect(token).toBeDefined();
+        expect(token!.children?.some(t => t.type === 'link')).toBe(true);
+    });
+
+    it('keeps em under the same trailing-paren shape', () => {
+        const token = tokenizer('*t [a](b)* (c)').find(t => t.type === 'em');
+        expect(token).toBeDefined();
+        expect(token!.children?.some(t => t.type === 'link')).toBe(true);
+    });
+
+    it('keeps strong around an image with a following paren clause', () => {
+        const token = strong('**see ![pic](a.png)** (full size)');
+        expect(token).toBeDefined();
+        expect(token!.children?.some(t => t.type === 'image')).toBe(true);
+    });
+
+    it('still rejects a strong span truly cut by a link', () => {
+        // *[foo*](bar): the link binds tighter — no strong/em may span it.
+        expect(strong('**t [a**](b)**')).toBeUndefined();
+    });
+});
